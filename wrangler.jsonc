{
  // Cloudflare Worker configuration. Nothing here is deployed automatically:
  // run `npm run deploy` yourself when you are ready.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "color-me-worst",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // The built app. Run `npm run build` first.
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths fall back to index.html, as a single-page app expects.
    "not_found_handling": "single-page-application",
    // Only /api/* runs the Worker; everything else is served straight from assets.
    "run_worker_first": ["/api/*"]
  },
  // Counts photo imports per client and per day. Created automatically on
  // first deploy; there is nothing to set up by hand.
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimitCounter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimitCounter"] }],
  // Settings for branch Previews (`npx wrangler preview`, run by Workers Builds
  // for non-production branches). Previews inherit nothing from the top level.
  // Each Preview gets its own isolated Durable Object namespace automatically;
  // the binding is repeated here because the code reads env.RATE_LIMITER.
  // Secrets are not inherited either, so photo import stays off in Previews
  // unless a GEMINI_API_KEY is set for them separately.
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimitCounter" }]
    }
  },
  "observability": { "enabled": true },
  // Do not send Wrangler usage telemetry from this project.
  "send_metrics": false

  // Photo import stays switched off until a Gemini API key (from Google AI
  // Studio) is stored as a secret (never in this file):
  //      npx wrangler secret put GEMINI_API_KEY
  //
  // Optional: "vars": { "VISION_MODEL": "gemini-3.8-flash" }
}
